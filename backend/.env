# ==============================================================================
# Multi-Branch Inventory & Warehouse Management System Environment Configuration
# ==============================================================================

# Django Core Settings
SECRET_KEY=django-insecure-multi-branch-warehouse-system-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# Database Configuration
# Set DB_ENGINE to 'sqlite' for local development or 'postgresql' for PostgreSQL database
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF Security Settings
CORS_ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
